# URL pública del sitio (sin / final)
NEXT_PUBLIC_SITE_URL=https://silverjob.cl

# Mercado Pago (credenciales de prueba TEST-..., luego las de producción APP_USR-...)
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta que muestra Mercado Pago al configurar el webhook
MERCADOPAGO_WEBHOOK_SECRET=

# Los precios están en lib/precios.ts. Sin MERCADOPAGO_ACCESS_TOKEN, /pagar indica que los pagos no están abiertos.

# Opcional: otro Apps Script para la lista de espera
# NEXT_PUBLIC_LISTA_ENDPOINT=

# --- Redes sociales (panel en /admin/redes) ---
# Clave para entrar al panel
ADMIN_REDES_CLAVE=
# Secreto del cron (Vercel lo envía como Bearer a /api/cron/redes)
CRON_SECRET=
# Cola de publicaciones: proyecto Supabase con la tabla de supabase/redes.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Redacción con Claude (sin clave se usa una plantilla simple)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# LinkedIn: token con w_organization_social (o w_member_social) y el autor (urn:li:organization:123 o urn:li:person:abc)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTOR=
# Instagram: cuenta profesional vinculada a una página de Facebook; token de larga duración
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Automatización: 1 = el cron mantiene la cola llena / la programa sin revisión previa
REDES_AUTOGENERAR=0
REDES_AUTOAPROBAR=0
