# URL pública del sitio (sin / final)
NEXT_PUBLIC_SITE_URL=https://silverjob.cl

# Mercado Pago (credenciales de prueba TEST-... en Preview; las de producción APP_USR-... solo en Production)
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta que muestra Mercado Pago al configurar el webhook
MERCADOPAGO_WEBHOOK_SECRET=

# Supabase (lista de espera y pagos). SOLO servidor: nunca con prefijo NEXT_PUBLIC_.
# Marcar como Sensitive en Vercel. Usar la clave secreta (sb_secret_...), no la publicable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile (captcha). Sin estas claves queda desactivado.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Respaldo temporal mientras Supabase no esté configurado: Apps Script de la planilla.
# LISTA_ENDPOINT es solo servidor (ya no se expone en el navegador); LISTA_TOKEN debe
# coincidir con la propiedad CLAVE del script.
# LISTA_ENDPOINT=
# LISTA_TOKEN=

# Los precios están en lib/precios.ts. Sin MERCADOPAGO_ACCESS_TOKEN, /pagar indica que los pagos no están abiertos.
